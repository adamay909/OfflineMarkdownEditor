{
  "name": "MDEditor",
  "short_name": "MDEditor",
  "description": "A markdown editor for local files.",
  "start_url": "/mdeditor/",
  "scope": "/mdeditor/",
  "display": "minimal-ui",
  "background_color": "#EEF0EA",
  "theme_color": "#EEF0EA",
  "orientation": "any",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/mdeditor/",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      }
    }
  ]
}
