{
  "name": "MDEditor",
  "short_name": "MDEditor",
  "description": "A markdown editor for local files.",
  "start_url": "/mdeditor/",
  "scope": "/mdeditor/",
  "display": "standalone",
  "background_color": "#EEF0EA",
  "theme_color": "#EEF0EA",
  "orientation": "any",
  "icons": [
    { "src": "./icon192.png", 
	  "sizes": "192x192", 
	  "type": "image/png", 
	  "purpose": "any" 
	},
    { "src": "./icon512.png", 
	  "sizes": "any", 
	  "type": "image/png", 
	  "purpose": "maskable"
   	},
    { "src": "./icon512.png", 
	  "sizes": "any", 
	  "type": "image/png", 
	  "purpose": "any"
   	}
  ],
  "file_handlers": [
    {
      "action": "/mdeditor/",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      }
    }
  ]
}
